    <worksheet name='Size vs Installs'>
      <table>
        <view>
          <datasources>
            <datasource caption='googleplaystore' name='federated.0gwnit21xouwcy1go0bhh0qgyihv' />
          </datasources>
          <datasource-dependencies datasource='federated.0gwnit21xouwcy1go0bhh0qgyihv'>
            <column caption='Size MB' datatype='real' name='[Calculation_1200442208464897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF RIGHT([Size], 1) = &quot;M&quot; THEN&#13;&#10;    FLOAT(LEFT([Size], LEN([Size]) - 1))&#13;&#10;&#13;&#10;ELSEIF RIGHT([Size], 1) = &quot;k&quot; THEN&#13;&#10;    FLOAT(LEFT([Size], LEN([Size]) - 1)) / 1024&#13;&#10;&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='Installs Number' datatype='real' name='[Calculation_1200442210189314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(&#13;&#10;    REPLACE(&#13;&#10;        REPLACE([Installs], &quot;,&quot;, &quot;&quot;),&#13;&#10;        &quot;+&quot;, &quot;&quot;&#13;&#10;    )&#13;&#10;)' />
            </column>
            <column caption='Size Band ' datatype='string' name='[Calculation_1200442242166792]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1200442208464897] &lt; 5 THEN &quot;0–5 MB&quot;&#13;&#10;ELSEIF [Calculation_1200442208464897] &lt; 10 THEN &quot;5–10 MB&quot;&#13;&#10;ELSEIF [Calculation_1200442208464897] &lt; 25 THEN &quot;10–25 MB&quot;&#13;&#10;ELSEIF [Calculation_1200442208464897] &lt; 50 THEN &quot;25–50 MB&quot;&#13;&#10;ELSEIF [Calculation_1200442208464897] &lt; 75 THEN &quot;50–75 MB&quot;&#13;&#10;ELSE &quot;75–100 MB&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' datatype-customized='true' name='[Installs]' role='dimension' type='nominal' />
            <column datatype='string' name='[Size]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1200442242166792]' derivation='None' name='[none:Calculation_1200442242166792:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1200442210189314]' derivation='Sum' name='[sum:Calculation_1200442210189314:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
