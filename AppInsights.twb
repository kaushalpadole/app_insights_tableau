            <column caption='Price Band' datatype='string' name='[Calculation_1200442237239303]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF FLOAT(REPLACE([Price], &quot;$&quot;, &quot;&quot;)) = 0 THEN &quot;Free&quot;&#13;&#10;ELSEIF FLOAT(REPLACE([Price], &quot;$&quot;, &quot;&quot;)) &lt; 5 THEN &quot;$0.99–$4.99&quot;&#13;&#10;ELSEIF FLOAT(REPLACE([Price], &quot;$&quot;, &quot;&quot;)) &lt; 10 THEN &quot;$5–$9.99&quot;&#13;&#10;ELSEIF FLOAT(REPLACE([Price], &quot;$&quot;, &quot;&quot;)) &lt; 20 THEN &quot;$10–$19.99&quot;&#13;&#10;ELSEIF FLOAT(REPLACE([Price], &quot;$&quot;, &quot;&quot;)) &lt; 50 THEN &quot;$20–$49.99&quot;&#13;&#10;ELSEIF FLOAT(REPLACE([Price], &quot;$&quot;, &quot;&quot;)) &lt; 100 THEN &quot;$50–$99.99&quot;&#13;&#10;ELSE &quot;$100+&quot;&#13;&#10;END' />
