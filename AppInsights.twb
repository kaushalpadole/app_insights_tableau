      <aliases enabled='yes' />
      <column datatype='string' name='[App]' role='dimension' type='nominal' />
      <column caption='Size MB' datatype='real' name='[Calculation_1200442208464897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF RIGHT([Size], 1) = &quot;M&quot; THEN&#13;&#10;    FLOAT(LEFT([Size], LEN([Size]) - 1))&#13;&#10;&#13;&#10;ELSEIF RIGHT([Size], 1) = &quot;k&quot; THEN&#13;&#10;    FLOAT(LEFT([Size], LEN([Size]) - 1)) / 1024&#13;&#10;&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
      </column>
      <column caption='Installs Number' datatype='real' name='[Calculation_1200442210189314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(&#13;&#10;    REPLACE(&#13;&#10;        REPLACE([Installs], &quot;,&quot;, &quot;&quot;),&#13;&#10;        &quot;+&quot;, &quot;&quot;&#13;&#10;    )&#13;&#10;)' />
      </column>
      <column caption='Is Rates 4+' datatype='integer' name='[Calculation_1200442218295299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Rating] &gt;= 4 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Installs Bin' datatype='string' name='[Calculation_1200442225623045]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1200442210189314] &lt; 100000 THEN &quot;0–100K&quot;&#13;&#10;ELSEIF [Calculation_1200442210189314] &lt; 500000 THEN &quot;100K–500K&quot;&#13;&#10;ELSEIF [Calculation_1200442210189314] &lt; 1000000 THEN &quot;500K–1M&quot;&#13;&#10;ELSEIF [Calculation_1200442210189314] &lt; 5000000 THEN &quot;1M–5M&quot;&#13;&#10;ELSEIF [Calculation_1200442210189314] &lt; 10000000 THEN &quot;5M–10M&quot;&#13;&#10;ELSEIF [Calculation_1200442210189314] &lt; 50000000 THEN &quot;10M–50M&quot;&#13;&#10;ELSEIF [Calculation_1200442210189314] &lt; 100000000 THEN &quot;50M–100M&quot;&#13;&#10;ELSEIF [Calculation_1200442210189314] &lt; 500000000 THEN &quot;100M–500M&quot;&#13;&#10;ELSEIF [Calculation_1200442210189314] &lt; 1000000000 THEN &quot;500M–1B&quot;&#13;&#10;ELSE &quot;1B+&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Band' datatype='string' name='[Calculation_1200442237239303]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF FLOAT(REPLACE([Price], &quot;$&quot;, &quot;&quot;)) = 0 THEN &quot;Free&quot;&#13;&#10;ELSEIF FLOAT(REPLACE([Price], &quot;$&quot;, &quot;&quot;)) &lt; 5 THEN &quot;$0.99–$4.99&quot;&#13;&#10;ELSEIF FLOAT(REPLACE([Price], &quot;$&quot;, &quot;&quot;)) &lt; 10 THEN &quot;$5–$9.99&quot;&#13;&#10;ELSEIF FLOAT(REPLACE([Price], &quot;$&quot;, &quot;&quot;)) &lt; 20 THEN &quot;$10–$19.99&quot;&#13;&#10;ELSEIF FLOAT(REPLACE([Price], &quot;$&quot;, &quot;&quot;)) &lt; 50 THEN &quot;$20–$49.99&quot;&#13;&#10;ELSEIF FLOAT(REPLACE([Price], &quot;$&quot;, &quot;&quot;)) &lt; 100 THEN &quot;$50–$99.99&quot;&#13;&#10;ELSE &quot;$100+&quot;&#13;&#10;END' />
      </column>
      <column caption='Size Band ' datatype='string' name='[Calculation_1200442242166792]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1200442208464897] &lt; 5 THEN &quot;0–5 MB&quot;&#13;&#10;ELSEIF [Calculation_1200442208464897] &lt; 10 THEN &quot;5–10 MB&quot;&#13;&#10;ELSEIF [Calculation_1200442208464897] &lt; 25 THEN &quot;10–25 MB&quot;&#13;&#10;ELSEIF [Calculation_1200442208464897] &lt; 50 THEN &quot;25–50 MB&quot;&#13;&#10;ELSEIF [Calculation_1200442208464897] &lt; 75 THEN &quot;50–75 MB&quot;&#13;&#10;ELSE &quot;75–100 MB&quot;&#13;&#10;END' />
      </column>
      <column caption='Reviews Filter' datatype='boolean' name='[Calculation_1825514635026432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Reviews] &gt;= [Parameters].[Parameter 1]' />
      </column>
      <column caption='Rating Score' datatype='real' name='[Calculation_1825514635276289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([Rating]) * 100000000 + MAX([Reviews])' />
