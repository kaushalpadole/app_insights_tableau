            <column caption='Install Tier' datatype='string' name='[Install_Tier]' role='dimension' type='nominal' />
            <column-instance column='[Install_Tier]' derivation='None' name='[none:Install_Tier:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gwnit21xouwcy1go0bhh0qgyihv'>
            <column datatype='string' name='[App]' role='dimension' type='nominal' />
            <column caption='Installs Number' datatype='real' name='[Calculation_1200442210189314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(&#13;&#10;    REPLACE(&#13;&#10;        REPLACE([Installs], &quot;,&quot;, &quot;&quot;),&#13;&#10;        &quot;+&quot;, &quot;&quot;&#13;&#10;    )&#13;&#10;)' />
            </column>
            <column caption='Installs Bin' datatype='string' name='[Calculation_1200442225623045]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1200442210189314] &lt; 100000 THEN &quot;0–100K&quot;&#13;&#10;ELSEIF [Calculation_1200442210189314] &lt; 500000 THEN &quot;100K–500K&quot;&#13;&#10;ELSEIF [Calculation_1200442210189314] &lt; 1000000 THEN &quot;500K–1M&quot;&#13;&#10;ELSEIF [Calculation_1200442210189314] &lt; 5000000 THEN &quot;1M–5M&quot;&#13;&#10;ELSEIF [Calculation_1200442210189314] &lt; 10000000 THEN &quot;5M–10M&quot;&#13;&#10;ELSEIF [Calculation_1200442210189314] &lt; 50000000 THEN &quot;10M–50M&quot;&#13;&#10;ELSEIF [Calculation_1200442210189314] &lt; 100000000 THEN &quot;50M–100M&quot;&#13;&#10;ELSEIF [Calculation_1200442210189314] &lt; 500000000 THEN &quot;100M–500M&quot;&#13;&#10;ELSEIF [Calculation_1200442210189314] &lt; 1000000000 THEN &quot;500M–1B&quot;&#13;&#10;ELSE &quot;1B+&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' datatype-customized='true' name='[Installs]' role='dimension' type='nominal' />
            <column-instance column='[App]' derivation='Count' name='[cnt:App:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1200442225623045]' derivation='None' name='[none:Calculation_1200442225623045:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <computed-sort column='[federated.0gwnit21xouwcy1go0bhh0qgyihv].[none:Calculation_1200442225623045:nk]' direction='DESC' using='[federated.0gwnit21xouwcy1go0bhh0qgyihv].[cnt:App:qk]' />
